
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
# Archive recipe gate lock (beads pre-commit)
!.beads/
.beads/*
!.beads/config.yaml
.beads-credential-key
# Beads / Dolt files (added by bd init)
.beads.gate.lock
!.beads/.gitignore
!.beads/issues.jsonl
# Beads (no-db mode: .beads/issues.jsonl is the source of truth, tracked in git)
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
/book/
# Vendored mermaid bundle (mdbook-mermaid): fetched by `just docs-mermaid`,
# not tracked — pretender's --staged gate lints tracked .js files regardless
# of the vendor/** exclude, and a 2.6k-line minified bundle can never pass
# a ratchet built for project code. mermaid-init.js (39 lines, hand-sized)
# IS tracked. Version pinned — keep in lockstep with mdbook-mermaid 0.17.1.
vendor/mermaid.min.js
# Contains mutation testing data
*.db
debug
docs/book/
docs/src/openspec/
docs/src/specs/
.dolt/
# Generated by Cargo
# Generated by cargo mutants
#.idea/
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
# mdBook docs: generated copies of the spec trees + build output
# MSVC Windows builds of rustc generate these, which store debugging information
**/mutants.out*/
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
*.pdb
**/*.rs.bk
# RustRover
# (source of truth is specs/ and openspec/specs/ — copied at build time)
target
# The global ~/.gitignore excludes .beads/ — re-include the tracked files.
# These are backup files generated by rustfmt
# will have compiled files and executables
# Release workflow scratch (release.yml Publish Release job): binaries are
# downloaded to bins/ and archives staged in dist/ at the repo root before
# `cargo publish --allow-dirty` runs — unignored, cargo package packs them
# into the .crate and crates.io rejects the upload (413 Payload Too Large).
/bins/
/dist/
.pretender/
# release.md is stamped from Cargo.toml by scripts/stamp_llms.py and is
# TRACKED since specodelic-lf4b.11 (commit-stamp at release time — repo
# browsers read it straight from git; release.yml re-stamps on tag push)
# docs/src/release.md

# Derived graph views (add-graph-views D6): regenerated by `just
# docs-graphs` into the docs build path — build-time artifacts, never
# committed, so graph_is_derived_not_authored holds by construction
docs/src/views/

# Python bytecode (scripts/ tooling) — covered globally on some machines only
__pycache__/
*.pyc

# Whisper knowledge workspace — per-machine session state, never project state
.whisper/
