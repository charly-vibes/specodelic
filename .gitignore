
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
# Archive recipe gate lock (beads pre-commit)
!.beads/
.beads/*
!.beads/config.yaml
.beads-credential-key
# Beads / Dolt files (added by bd init)
.beads.gate.lock
!.beads/.gitignore
!.beads/issues.jsonl
# Beads (no-db mode: .beads/issues.jsonl is the source of truth, tracked in git)
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
/book/
# Contains mutation testing data
*.db
debug
docs/book/
docs/src/openspec/
docs/src/specs/
.dolt/
# Generated by Cargo
# Generated by cargo mutants
#.idea/
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
# mdBook docs: generated copies of the spec trees + build output
# MSVC Windows builds of rustc generate these, which store debugging information
**/mutants.out*/
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
*.pdb
**/*.rs.bk
# RustRover
# (source of truth is specs/ and openspec/specs/ — copied at build time)
target
# The global ~/.gitignore excludes .beads/ — re-include the tracked files.
# These are backup files generated by rustfmt
# will have compiled files and executables
# Release workflow scratch (release.yml Publish Release job): binaries are
# downloaded to bins/ and archives staged in dist/ at the repo root before
# `cargo publish --allow-dirty` runs — unignored, cargo package packs them
# into the .crate and crates.io rejects the upload (413 Payload Too Large).
/bins/
/dist/
.pretender/
# §6: generated from Cargo.toml by docs.yml — never committed
docs/src/release.md

# Python bytecode (scripts/ tooling) — covered globally on some machines only
__pycache__/
*.pyc
